# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceThisWithYourRealToken

# Optional: Telegram user IDs (comma separated) that can always create quizzes,
# even in groups where they aren't a Telegram "admin". Leave blank to skip.
EXTRA_ADMIN_IDS=

# SQLite database file path (created automatically)
DB_PATH=quizbot.db

# Timezone used when you type quiz start times, e.g. Asia/Kolkata, America/New_York
TIMEZONE=Asia/Kolkata
